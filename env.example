# Copy this file to .env and fill in ONE provider's key.
# Never commit the real .env — it's already in .gitignore.

# Which provider to use. Default is gemini (currently the only genuinely
# free option — no card required, generous daily limits for this dataset's
# size). Change to anthropic or openai any time without touching code.
LLM_PROVIDER=gemini

# Optional: override the default model for your chosen provider.
# Defaults if unset: gemini-2.0-flash-lite | claude-haiku-4-5-20251001 | gpt-4o-mini
# gemini-2.0-flash-lite is used specifically because it has a much larger
# free daily quota (1,500 req/day) than the newer gemini-3.x models
# (which measured ~20 req/day free as of Sept 2026 — hit this the hard way).
# LLM_MODEL=

# --- Only fill in the key for the provider you picked above ---

# Get a free key at https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Get a key at https://console.anthropic.com/settings/keys (requires billing)
# ANTHROPIC_API_KEY=

# Get a key at https://platform.openai.com/api-keys (requires billing)
# OPENAI_API_KEY=